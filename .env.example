# Portfolio Application Environment Variables
# Copy this file to .env and fill in your values

# ====================================================================
# MODE CONFIGURATION
# ====================================================================
# Set to True for demo mode (uses pre-computed sample data, no API calls)
# Set to False for live mode (processes real CVs, requires API key)
# Default: True (demo mode for safe public deployment)
PORTFOLIO_DEMO_MODE=True

# ====================================================================
# API KEYS (only needed for LIVE mode)
# ====================================================================
# Google Gemini API key for text generation and RAG chatbot
# Get your key from: https://makersuite.google.com/app/apikey
# Only required when PORTFOLIO_DEMO_MODE=False
GOOGLE_API_KEY=your_api_key_here

# ====================================================================
# APPLICATION SETTINGS (optional)
# ====================================================================
# Flask secret key for session management
# AUTO-GENERATED if not provided
SECRET_KEY=your_secret_key_here

# Debug mode (True/False)
# Default: False
DEBUG=False
